# Chicago Crime Project Environment Variables

# Required: Anthropic API Key for Claude
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Optional: Chicago Data Portal App Token (improves rate limits)
CHICAGO_DATA_APP_TOKEN=your_chicago_data_token_here

# LangSmith Configuration for LLM Observability
LANGCHAIN_TRACING_V2=true
LANGCHAIN_PROJECT=chicago-crime-analysis
LANGCHAIN_API_KEY=your_langchain_api_key

# Optional: LangSmith Endpoint (use default if not specified)
# LANGCHAIN_ENDPOINT=https://api.smith.langchain.com